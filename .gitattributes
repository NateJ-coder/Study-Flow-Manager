# Normalize text files to LF in the repository, regardless of what a given
# editor/OS wrote to the working tree. This is what was missing before —
# without it, files committed with mixed CRLF/LF show up as "modified" on
# every checkout even with no real content change.
* text=auto eol=lf

*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.rules text eol=lf

# Binary assets — never touch, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.mp3 binary
*.wav binary
*.ico binary
